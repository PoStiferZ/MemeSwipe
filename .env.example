# Helius
HELIUS_API_KEY=

# Supabase Postgres (use the "Connection string" / Pooler URL)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Public app URL (used for webhook registration)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Webhook auth (random string, sent as Authorization header on Helius webhooks)
HELIUS_WEBHOOK_AUTH_TOKEN=

# Cron auth (random string, used by Vercel Cron header)
CRON_SECRET=
